---
import BentoCard from "../BentoCard.astro";
import siteData from "../../data/site.json";

const { labels } = siteData;

// GitHub username extracted from site data
const githubUser = siteData.contact?.github
  ? new URL(siteData.contact.github).pathname.replace(/^\//, '').replace(/\/$/, '')
  : 'alarcia';

// Build-time fetch using optional GITHUB_TOKEN secret (if available)
const token = import.meta.env.GITHUB_TOKEN || process.env.GITHUB_TOKEN;

let initialRepos = "—";
let initialContributions = "—";

if (token) {
  try {
    const res = await fetch("https://api.github.com/graphql", {
      method: "POST",
      headers: {
        Authorization: `bearer ${token}`,
        "Content-Type": "application/json",
        "User-Agent": "alarcia.dev-portfolio",
      },
      body: JSON.stringify({
        query: `
          query {
            user(login: "${githubUser}") {
              contributionsCollection {
                contributionCalendar {
                  totalContributions
                }
              }
              repositories(ownerAffiliations: OWNER) {
                totalCount
              }
            }
          }
        `,
      }),
    });
    if (res.ok) {
      const data = await res.json();
      if (data.data?.user) {
        initialContributions = String(data.data.user.contributionsCollection.contributionCalendar.totalContributions);
        initialRepos = String(data.data.user.repositories.totalCount);
      }
    }
  } catch {
    // Keep defaults on error
  }
}

// Fallback / initial stats shown before client-side fetch completes
const fallbackStats = {
  contributions: initialContributions,
  repositories: initialRepos,
};

interface Props {
  delayIndex?: number;
}
const { delayIndex } = Astro.props;
---

<BentoCard delayIndex={delayIndex} className="github-activity">
  {
    labels.githubActivity && labels.githubActivity.trim() !== "" && (
      <h2 class="section-title" id="activity">
        {labels.githubActivity}
      </h2>
    )
  }

  <div class="activity-graph-container">
    <a
      href={siteData.contact.github}
      target="_blank"
      rel="noopener noreferrer"
      class="activity-link"
    >
      <img
        src="https://ghchart.rshah.org/40c463/alarcia"
        alt="GitHub Contributions for alarcia"
        class="activity-chart"
        loading="lazy"
        width="600"
        height="100"
      />
    </a>
  </div>

  <div class="stats-grid">
    <div class="stat-item">
      <span class="stat-value text-mono" data-stat-contributions>{fallbackStats.contributions}</span>
      <span class="stat-label text-secondary">Contributions</span>
    </div>
    <div class="stat-item">
      <span class="stat-value text-mono" data-stat-repositories>{fallbackStats.repositories}</span>
      <span class="stat-label text-secondary">Repositories</span>
    </div>
  </div>
</BentoCard>

<script define:vars={{ githubUser }}>
  const contribEl = document.querySelector('.github-activity [data-stat-contributions]');
  const reposEl = document.querySelector('.github-activity [data-stat-repositories]');

  const fetchGithubStats = async () => {
    if (!contribEl || !reposEl) return;

    const controller = new AbortController();
    const timeoutId = window.setTimeout(() => controller.abort(), 5000);

    try {
      const [userRes, contribRes] = await Promise.all([
        fetch(`https://api.github.com/users/${githubUser}`, {
          signal: controller.signal,
          cache: 'no-store',
        }),
        fetch(`https://github-contributions-api.jogruber.de/v4/${githubUser}?y=last`, {
          signal: controller.signal,
          cache: 'no-store',
        }),
      ]);

      if (userRes.ok) {
        const userData = await userRes.json();
        reposEl.textContent = userData.public_repos;
      }

      if (contribRes.ok) {
        const contribData = await contribRes.json();
        if (contribData.total?.lastYear !== undefined) {
          contribEl.textContent = contribData.total.lastYear;
        }
      }
    } catch {
      // Keep fallback values on error
    } finally {
      window.clearTimeout(timeoutId);
    }
  };

  fetchGithubStats();
</script>

<style>
  .activity-graph-container {
    width: 100%;
    background-color: transparent;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 2 / 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  .activity-link {
    display: flex;
    width: 100%;
    height: 100%;
    justify-content: flex-end;
    align-items: center;
    text-decoration: none;
  }

  .activity-chart {
    height: 100%;
    width: auto;
    object-fit: cover;
    object-position: -25px -25px;
    filter: saturate(0.9);
    transition: filter 0.3s ease;
  }

  .activity-chart:hover {
    filter: saturate(1.1);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .stat-label {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .stat-value {
      font-size: 1.25rem;
    }
  }
</style>
